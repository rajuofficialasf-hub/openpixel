{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  // Vendored third-party runtime (tesseract.js worker + core, copied
  // from node_modules into public/ so the app self-hosts OCR): lint
  // our code, not upstream's minified Emscripten output.
  "ignorePatterns": ["public/tesseract/**"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  }
}
