{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "dragDropEnabled": true,
        "height": 750,
        "minHeight": 600,
        "minWidth": 820,
        "title": "OpenPixel",
        "width": 1100
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "category": "Graphics and Design",
    "longDescription": "OpenPixel Engine desktop app: convert images between 16 formats with the native Rust engine. No server, no uploads, no account \u2014 everything runs on your machine.",
    "shortDescription": "Local image conversion \u2014 files never leave your device.",
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  },
  "identifier": "dev.openpixel.desktop",
  "productName": "OpenPixel",
  "version": "0.1.0"
}